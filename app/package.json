{
  "name": "aura-app",
  "version": "0.1.2",
  "private": true,
  "description": "AURA - fenetre applicative (toile maillee & conversation)",
  "main": "main.js",
  "author": "Lucas Zanelli",
  "bin": {
    "aura": "./bin/aura.js"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "node scripts/publish-release.js"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "three": "^0.128.0"
  },
  "build": {
    "appId": "org.les-z.aura",
    "productName": "AURA",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/fix-exe-subsystem.js",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "server.js",
      "store.js",
      "router.js",
      "productivity.js",
      "autonomy.js",
      "security.js",
      "connectors/**/*",
      "providers/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraFiles": [
      {
        "from": "launched-profile-template.ps1",
        "to": "launched-profile.ps1"
      }
    ],
    "win": {
      "executableName": "aura",
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "ZanelliLucas",
      "repo": "AURA"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "systeminformation": "^5.33.9"
  }
}
